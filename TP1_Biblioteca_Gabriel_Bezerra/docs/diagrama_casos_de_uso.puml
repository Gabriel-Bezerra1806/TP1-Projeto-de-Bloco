@startuml
left to right direction
skinparam packageStyle rectangle
actor "Membro" as M
actor "Bibliotecário /\nAdministrador" as B
rectangle "Sistema de Gestão de Biblioteca Universitária" {
  usecase "Consultar acervo" as UC1
  usecase "Solicitar empréstimo" as UC2
  usecase "Registrar devolução" as UC3
  usecase "Calcular multa" as UC4
  usecase "Reservar livro" as UC5
  usecase "Cadastrar livros e exemplares" as UC6
  usecase "Cadastrar membros" as UC7
  usecase "Processar empréstimo" as UC8
}
M -- UC1
M -- UC2
M -- UC5
M -- UC3
B -- UC6
B -- UC7
B -- UC8
B -- UC3
UC3 .> UC4 : <<include>>
UC2 .> UC8 : <<include>>
@enduml
